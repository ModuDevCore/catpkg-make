#!/bin/sh

catstrap_cli_doc_path="./DOCS/catstrap-cli"
catpkg_make_doc_path="./DOCS/catpkg-make"
catpkg_cli_doc_path="./DOCS/catpkg-cli"
CATPKG_DSL_doc_path="./DOCS/CATPKG-DSL"

catpkg_console_font="./FONTS/default8x16.psf"
catpkg_braille_font="./FONTS/brl-16.psf"
catpkg_old_font="/tmp/catpkg-docs-old-font.psf"

restore_font()
{
	if [ -f "$catpkg_old_font" ]; then
		echo
		echo "catpkg-docs: Restoring console font..."
		sudo setfont "$catpkg_old_font"
		rm -f "$catpkg_old_font"
	fi
}

if [ "$TERM" = "linux" ] &&
	command -v setfont >/dev/null 2>&1 &&
	[ -f "$catpkg_console_font" ] &&
	[ -f "$catpkg_braille_font" ]; then

	echo "catpkg-docs: Installing temporary console fonts..."
	echo "catpkg-docs: Administrator privileges are required to change the console font."

	if sudo setfont -o "$catpkg_old_font" \
		"$catpkg_console_font" \
		"$catpkg_braille_font"; then

		trap restore_font EXIT INT TERM
	else
		echo "catpkg-docs: Failed to install console fonts."
	fi
fi

show_help()
{
	cat "./DOCS/SRC/TEXTBANER"
	echo
	echo "catpkg-docs: Documentation viewer"
	echo
	echo "Available documentation:"
	echo "  catpkg-docs catstrap"
	echo "  catpkg-docs make"
	echo "  catpkg-docs catpkg"
	echo "  catpkg-docs CATPKG"
	echo
	echo "Available commands:"
	echo "  help"
	echo "  exit"
	echo
}

show_doc()
{
	case "$1" in
		catstrap)
			less "$catstrap_cli_doc_path"
			;;

		make)
			less "$catpkg_make_doc_path"
			;;

		catpkg)
			less "$catpkg_cli_doc_path"
			;;

		CATPKG)
			less "$CATPKG_DSL_doc_path"
			;;

		*)
			return 1
			;;
	esac
}

show_interactive_doc()
{
	clear

	{
		echo "PRESS: 'q' FOR EXIT AND CHOOSE OTHER DOC."
		echo

		case "$1" in
			catstrap)
				cat "$catstrap_cli_doc_path"
				;;

			make)
				cat "$catpkg_make_doc_path"
				;;

			catpkg)
				cat "$catpkg_cli_doc_path"
				;;

			CATPKG)
				cat "$CATPKG_DSL_doc_path"
				;;
		esac
	} | less
}

case "$1" in

	--help|-h|help)
		show_help
		;;

	catstrap|make|catpkg|CATPKG)
		show_doc "$1"
		;;

	"")
		show_help

		while true; do
			printf "\ncatpkg-docs: "
			IFS= read -r doc

			case "$doc" in
				catstrap|make|catpkg|CATPKG)
					show_interactive_doc "$doc"
					;;

				help)
					show_help
					;;

				exit|quit)
					exit 0
					;;

				"")
					;;

				*)
					echo "catpkg-docs: Unknown documentation or command: $doc"
					;;
			esac
		done
		;;

	*)
		echo "catpkg-docs: Unknown documentation or command: $1"
		echo
		show_help
		exit 1
		;;

esac